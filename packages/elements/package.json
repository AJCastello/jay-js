{
  "name": "@jay-js/elements",
  "version": "1.2.1",
  "description": "A headless library of basic elements for Jay JS framework.",
  "deprecated": "This package has been replaced by native JSX components. Do not use.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:types": "tsc --emitDeclarationOnly --declaration --skipLibCheck",
    "prebuild": "rimraf ./dist",
    "build": "bun build src/index.ts --outdir dist --target browser --format esm --external @jay-js/system && npm run build:types",
    "postbuild": "cpy ./src/**/*.{css,styled} ./dist && clean-package && cpy ./package.json ./dist && cpy ./README.md ./dist && clean-package restore",
    "pub": "cd ./dist && npm publish --access public",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write ./src",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:cover": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "clean-package": "../../clean-package.config.json",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AJCastello/jay-js.git",
    "directory": "packages/elements"
  },
  "keywords": [
    "Jay",
    "js",
    "single page application",
    "library",
    "elements",
    "components",
    "headless",
    "ui-components",
    "web-components"
  ],
  "author": "AJ Castello",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AJCastello/jay-js/issues"
  },
  "homepage": "https://github.com/AJCastello/jay-js#readme",
  "peerDependencies": {
    "@jay-js/system": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.3",
    "@jay-js/system": "^4.0.1",
    "@vitest/ui": "^4.0.4",
    "jsdom": "^27.0.1",
    "typescript": "^5.4.5",
    "vitest": "^4.0.4"
  }
}
