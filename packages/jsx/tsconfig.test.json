{
  "compilerOptions": {
    "target": "ES6",
    "module": "ES6",
    "lib": ["ESNext", "DOM"],
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@jay-js/jsx",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@jay-js/jsx": ["./src/index.ts"],
      "@jay-js/jsx/*": ["./src/*"],
      "@jay-js/elements": ["../elements/dist"]
    }
  },
  "include": ["test-jsx.tsx", "src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "node_modules"]
}
