{
  "compilerOptions": {
    "target": "ES6",
    "module": "ES6",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@jay-js/system",
    "sourceMap": true,
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "noImplicitAny": true,
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "paths": {
      "@jay-js/system": ["../system/src/index.ts"],
      "@jay-js/system/*": ["../system/src/*"],
      "@jay-js/system/jsx-runtime": ["../system/src/jsx/core/jsx-runtime.ts"],
      "@jay-js/system/jsx-dev-runtime": ["../system/src/jsx/core/jsx-dev-runtime.ts"]
    }
  },
  "include": [
    "./src/**/*",
    "./src/index.ts",
  ],
  "exclude": [
    "./node_modules",
    "./dist"
  ]
}