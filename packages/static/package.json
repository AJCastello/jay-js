{
  "name": "@jay-js/static",
  "version": "1.3.1",
  "description": "A static site tools manager for Jay JS",
  "main": "dist/index.js",
  "types": "dist/index.d.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "rimraf ./dist",
    "build:types": "tsc --emitDeclarationOnly --declaration --skipLibCheck",
    "build": "bun build src/index.ts --outdir dist --target node --format esm --external gray-matter --external marked && npm run build:types",
    "postbuild": "clean-package && cpy ./package.json ./dist && cpy ./README.md ./dist && clean-package restore",
    "pub": "cd ./dist && npm publish --access public",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write ./src"
  },
  "publishConfig": {
    "access": "public"
  },
  "clean-package": "../../clean-package.config.json",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AJCastello/jay-js.git",
    "directory": "packages/system"
  },
  "keywords": [
    "Jay",
    "js",
    "single page application",
    "library",
    "ui",
    "framework",
    "web",
    "components",
    "static",
    "site",
    "generator",
    "blog",
    "website"
  ],
  "author": "AJ Castello",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AJCastello/jay-js/issues"
  },
  "homepage": "https://github.com/AJCastello/jay-js#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.2.3",
    "@types/jsdom": "^21.1.6",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^12.0.2"
  }
}